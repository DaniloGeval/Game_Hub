<!-- ***** Start Stream Start ***** -->
<div class="start-stream">
    <div class="col-lg-12">
        <div class="heading-section">
            <h4><em>@(isUk ? "Як розпочати" : "How To Start Your")</em> @(isUk ? "ваш прямий ефір" : "Live Stream")</h4>
        </div>
        <div class="row">
            <div class="col-lg-4">
                <div class="item">
                    <div class="icon">
                        <img src="~/assets/images/service-01.jpg" alt="" style="max-width: 60px; border-radius: 50%;">
                    </div>
                    <h4>@(isUk ? "Перейдіть до свого профілю" : "Go To Your Profile")</h4>
                    <p>@(isUk ? "Cyborg Gaming — це безкоштовний шаблон веб-сайту HTML CSS, наданий TemplateMo." : "Cyborg Gaming is free HTML CSS website template provided by TemplateMo. This is Bootstrap v5.2.0 layout.")</p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="item">
                    <div class="icon">
                        <img src="~/assets/images/service-02.jpg" alt="" style="max-width: 60px; border-radius: 50%;">
                    </div>
                    <h4>@(isUk ? "Кнопка прямого ефіру" : "Live Stream Button")</h4>
                    <p>@(isUk ? "Якщо ви хочете підтримати нас, ви можете зробити невеликий внесок через PayPal." : "If you wish to support us, you can make a small contribution via PayPal.")</p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="item">
                    <div class="icon">
                        <img src="~/assets/images/service-03.jpg" alt="" style="max-width: 60px; border-radius: 50%;">
                    </div>
                    <h4>@(isUk ? "Ви в ефірі" : "You Are Live")</h4>
                    <p>@(isUk ? "Вам не дозволяється розповсюджувати цей файл ZIP на інших сайтах колекцій шаблонів." : "You are not allowed to redistribute this template's downloadable ZIP file.")</p>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="main-button">
                    <a asp-controller="Home" asp-action="Profile">@(isUk ? "Перейти до профілю" : "Go To Profile")</a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ***** Start Stream End ***** -->

