@{
    ViewData["Title"] = "Details";
}

<!-- Автоматичне приховування preloader, щоб сторінка не зависала у вічному завантаженні -->
<style>
    #js-preloader {
        display: none !important;
        opacity: 0 !important;
        visibility: hidden !important;
    }
</style>

<div class="page-content">

    <!-- ***** Featured Start ***** -->
    <div class="row">
        <div class="col-lg-12">
            <div class="feature-banner header-text">
                <div class="row">
                    <div class="col-lg-4">
                        <img src="~/assets/images/feature-left.jpg" alt="Fortnite Banner" style="border-radius: 23px;">
                    </div>
                    <div class="col-lg-8">
                        <div class="thumb">
                            <img src="~/assets/images/feature-right.jpg" alt="Fortnite Trailer" style="border-radius: 23px;">
                            <a href="https://www.youtube.com/watch?v=r1b03uKWk_M" target="_blank"><i class="fa fa-play"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- ***** Featured End ***** -->
    <!-- ***** Details Start ***** -->
    <div class="game-details">
        <div class="row">
            <div class="col-lg-12">
                <h2>Fortnite Details</h2>
            </div>
            <div class="col-lg-12">
                <div class="content">
                    <div class="row">
                        <div class="col-lg-6">
                            <div class="left-info">
                                <div class="left">
                                    <h4>Fortnite</h4>
                                    <span>Sandbox</span>
                                </div>
                                <ul>
                                    <li><i class="fa fa-star"></i> 4.8</li>
                                    <li><i class="fa fa-download"></i> 2.3M</li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="right-info">
                                <ul>
                                    <li><i class="fa fa-star"></i> 4.8</li>
                                    <li><i class="fa fa-download"></i> 2.3M</li>
                                    <li><i class="fa fa-server"></i> 36GB</li>
                                    <li><i class="fa fa-gamepad"></i> Action</li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <img src="~/assets/images/details-01.jpg" alt="Screenshot 1" style="border-radius: 23px; margin-bottom: 30px;">
                        </div>
                        <div class="col-lg-4">
                            <img src="~/assets/images/details-02.jpg" alt="Screenshot 2" style="border-radius: 23px; margin-bottom: 30px;">
                        </div>
                        <div class="col-lg-4">
                            <img src="~/assets/images/details-03.jpg" alt="Screenshot 3" style="border-radius: 23px; margin-bottom: 30px;">
                        </div>
                        <div class="col-lg-12">
                            <p>Cyborg Gaming is free HTML CSS website template provided by TemplateMo. This is Bootstrap v5.2.0 layout. You can make a <a href="https://paypal.me/templatemo" target="_blank">small contribution via PayPal</a> to info [at] templatemo.com and thank you for supporting.</p>
                        </div>
                        <div class="col-lg-12">
                            <div class="main-border-button">
                                <a href="#">Download Fortnite Now!</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- ***** Details End ***** -->
    <!-- ***** Other Related Games Start ***** -->
    <div class="other-games">
        <div class="row">
            <div class="col-lg-12">
                <div class="heading-section">
                    <h4><em>Other Related</em> Games</h4>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="item">
                    <img src="~/assets/images/game-01.jpg" alt="Dota 2" class="templatemo-item">
                    <h4>Dota 2</h4><span>Sandbox</span>
                    <ul>
                        <li><i class="fa fa-star"></i> 4.8</li>
                        <li><i class="fa fa-download"></i> 2.3M</li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="item">
                    <img src="~/assets/images/game-02.jpg" alt="CS-GO" class="templatemo-item">
                    <h4>CS-GO</h4><span>FPS</span>
                    <ul>
                        <li><i class="fa fa-star"></i> 4.9</li>
                        <li><i class="fa fa-download"></i> 2.1M</li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="item">
                    <img src="~/assets/images/game-03.jpg" alt="PUBG" class="templatemo-item">
                    <h4>PUBG</h4><span>Battle Royale</span>
                    <ul>
                        <li><i class="fa fa-star"></i> 4.5</li>
                        <li><i class="fa fa-download"></i> 1.8M</li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="item">
                    <img src="~/assets/images/game-02.jpg" alt="Ea Sports" class="templatemo-item">
                    <h4>Ea Sports</h4><span>Sports</span>
                    <ul>
                        <li><i class="fa fa-star"></i> 4.7</li>
                        <li><i class="fa fa-download"></i> 1.2M</li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="item">
                    <img src="~/assets/images/game-03.jpg" alt="Valorant" class="templatemo-item">
                    <h4>Valorant</h4><span>Tactical Shooter</span>
                    <ul>
                        <li><i class="fa fa-star"></i> 4.8</li>
                        <li><i class="fa fa-download"></i> 2.5M</li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="item">
                    <img src="~/assets/images/game-01.jpg" alt="Apex Legends" class="templatemo-item">
                    <h4>Apex Legends</h4><span>Battle Royale</span>
                    <ul>
                        <li><i class="fa fa-star"></i> 4.6</li>
                        <li><i class="fa fa-download"></i> 1.9M</li>
                    </ul>
                </div>
            </div>

        </div>
    </div>
    <!-- ***** Other Related Games End ***** -->

</div>

@section Scripts {
    <script>
        // Додаткова гарантія зняття прелоадера після завантаження DOM
        $(document).ready(function () {
            $("#js-preloader").addClass('loaded');
        });
    </script>
}